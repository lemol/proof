{
  "name": "@lemol/proof",
  "version": "0.1.0",
  "private": true,
  "description": "Replay Playwright scenarios and write a versioned proof manifest",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./runner": "./src/runner/index.ts"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test:unit",
    "check:all": "bun run lint && bun run typecheck && bun run test",
    "lint": "oxfmt --check && oxlint",
    "fix": "oxlint --fix && oxfmt",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun run test:unit && bun run test:slow",
    "test:unit": "bun test src test/boundaries.test.ts",
    "test:slow": "bun test test/runner.slow.test.ts --timeout 60000"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.2",
    "effect": "4.0.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "playwright": "1.59.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "effect": "4.0.0",
    "playwright": ">=1.59.0 <2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.4"
}
